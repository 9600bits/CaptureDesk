<Window Style="{StaticResource AppWindowStyle}" x:Class="CaptureDesk.App.EditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑截图" Width="1100" Height="760" MinWidth="860" MinHeight="580" Background="{DynamicResource CanvasBrush}" WindowStartupLocation="CenterScreen" PreviewKeyDown="Editor_KeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="UndoButton" Style="{StaticResource VectorToolButton}" Content="{StaticResource UndoIcon}" ToolTip="撤销（Ctrl+Z）" AutomationProperties.Name="撤销" Click="Undo_Click" IsEnabled="False" />
                    <Button x:Name="RedoButton" Style="{StaticResource VectorToolButton}" Content="{StaticResource RedoIcon}" ToolTip="重做（Ctrl+Y）" AutomationProperties.Name="重做" Click="Redo_Click" IsEnabled="False" />
                    <Border Width="1" Height="22" Background="{DynamicResource LineBrush}" Margin="8,0" />
                    <StackPanel x:Name="ToolButtons" Orientation="Horizontal">
                        <Button Tag="select" Style="{StaticResource VectorToolButton}" Content="{StaticResource SelectIcon}" ToolTip="选择 / 移动标注" AutomationProperties.Name="选择工具" Click="Tool_Click" />
                        <Button Tag="rect" Style="{StaticResource VectorToolButton}" Content="{StaticResource RectangleIcon}" ToolTip="矩形" AutomationProperties.Name="矩形工具" Click="Tool_Click" />
                        <Button Tag="ellipse" Style="{StaticResource VectorToolButton}" Content="{StaticResource EllipseIcon}" ToolTip="椭圆" AutomationProperties.Name="椭圆工具" Click="Tool_Click" />
                        <Button Tag="arrow" Style="{StaticResource VectorToolButton}" Content="{StaticResource ArrowIcon}" ToolTip="箭头" AutomationProperties.Name="箭头工具" Click="Tool_Click" />
                        <Button Tag="pencil" Style="{StaticResource VectorToolButton}" Content="{StaticResource PencilIcon}" ToolTip="画笔" AutomationProperties.Name="画笔工具" Click="Tool_Click" />
                        <Button Tag="text" Style="{StaticResource VectorToolButton}" Content="{StaticResource TextIcon}" ToolTip="文字" AutomationProperties.Name="文字工具" Click="Tool_Click" />
                        <Button Tag="redact" Style="{StaticResource VectorToolButton}" Content="{StaticResource RedactIcon}" ToolTip="实色遮挡" AutomationProperties.Name="实色遮挡工具" Click="Tool_Click" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource VectorToolButton}" Content="{StaticResource PinIcon}" ToolTip="贴到桌面" AutomationProperties.Name="贴到桌面" Click="Pin_Click" />
                    <Button Style="{StaticResource VectorToolButton}" Content="{StaticResource CopyIcon}" ToolTip="复制（Ctrl+C）" AutomationProperties.Name="复制图像" Click="Copy_Click" />
                    <Button Style="{StaticResource PrimaryButton}" Height="36" Content="保存" AutomationProperties.Name="保存图像" Click="Save_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel><TextBlock x:Name="ToolStatus" FontSize="12" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="DocumentSize" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource MutedBrush}" /></DockPanel>
        </Border>
        <Border Margin="20" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="CanvasHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="SourceImage" Stretch="Fill" IsHitTestVisible="False" />
                    <Canvas x:Name="AnnotationCanvas" Background="Transparent" ClipToBounds="True" MouseLeftButtonDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseUp" LostMouseCapture="Canvas_LostCapture" />
                </Grid>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>




