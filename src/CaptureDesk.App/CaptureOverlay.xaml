<Window Style="{StaticResource AppWindowStyle}" x:Class="CaptureDesk.App.CaptureOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="False"
        Background="Black" Topmost="True" Cursor="Cross" PreviewKeyDown="Overlay_KeyDown">
    <Grid x:Name="InputSurface" Background="Transparent" ClipToBounds="True"
          MouseLeftButtonDown="Surface_MouseDown" MouseMove="Surface_MouseMove" MouseLeftButtonUp="Surface_MouseUp"
          MouseRightButtonDown="Surface_RightClick" LostMouseCapture="Surface_LostCapture">
        <Image x:Name="DesktopImage" Stretch="Fill" IsHitTestVisible="False" />
        <Path x:Name="DimMask" Fill="#78000000" IsHitTestVisible="False" />
        <Canvas x:Name="SelectionCanvas">
            <Viewbox x:Name="InlineEditorHost" Stretch="Fill" Visibility="Collapsed" />
            <Rectangle x:Name="SelectionRect" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
            <Path x:Name="Guides" Stroke="#AAFFFFFF" StrokeThickness="1" StrokeDashArray="3,3" IsHitTestVisible="False" />
            <Border x:Name="SizeBadge" Background="#24362C" CornerRadius="4" Padding="8,4" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
            </Border>
            <Border x:Name="ActionBar" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="4" Visibility="Collapsed" Cursor="Arrow">
                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource VectorToolButton}" Click="EditTool_Click" Tag="select" Content="{StaticResource SelectIcon}" ToolTip="选择 / 移动标注" AutomationProperties.Name="选择标注" />
                    <Button Style="{StaticResource VectorToolButton}" Click="EditTool_Click" Tag="rect" Content="{StaticResource RectangleIcon}" ToolTip="矩形标注" AutomationProperties.Name="矩形标注" />
                    <Button Style="{StaticResource VectorToolButton}" Click="EditTool_Click" Tag="ellipse" Content="{StaticResource EllipseIcon}" ToolTip="椭圆标注" AutomationProperties.Name="椭圆标注" />
                    <Button Style="{StaticResource VectorToolButton}" Click="EditTool_Click" Tag="pencil" Content="{StaticResource PencilIcon}" ToolTip="画笔标注" AutomationProperties.Name="画笔标注" />
                    <Button Style="{StaticResource VectorToolButton}" Click="EditTool_Click" Tag="arrow" Content="{StaticResource ArrowIcon}" ToolTip="箭头标注" AutomationProperties.Name="箭头标注" />
                    <Button Style="{StaticResource VectorToolButton}" Click="EditTool_Click" Tag="text" Content="{StaticResource TextIcon}" ToolTip="文字标注" AutomationProperties.Name="文字标注" />
                    <Button Style="{StaticResource VectorToolButton}" Click="EditTool_Click" Tag="redact" Content="{StaticResource RedactIcon}" ToolTip="实色遮挡" AutomationProperties.Name="实色遮挡" />
                    <Button x:Name="MoreAnnotations" Style="{StaticResource VectorToolButton}" Click="MoreAnnotations_Click" Tag="more" Content="{StaticResource ChevronDownIcon}" ToolTip="更多标注 / 颜色 / 粗细" AutomationProperties.Name="更多标注" />
                    <Border Width="1" Height="22" Margin="6,0" Background="{DynamicResource LineBrush}" />
                    <Button Style="{StaticResource VectorToolButton}" Click="Output_Click" Tag="long" Content="{StaticResource LongCaptureIcon}" ToolTip="长截图（实时捕获当前区域）" AutomationProperties.Name="选区长截图" />
                    <Button Style="{StaticResource VectorToolButton}" Click="Output_Click" Tag="record" Content="{StaticResource VideoIcon}" ToolTip="屏幕录制（实时捕获当前区域）" AutomationProperties.Name="选区屏幕录制" />
                    <Button Style="{StaticResource VectorToolButton}" Click="Output_Click" Tag="ocr" Content="{StaticResource OcrIcon}" ToolTip="文字识别" AutomationProperties.Name="选区文字识别" />
                    <Button Style="{StaticResource VectorToolButton}" Click="Output_Click" Tag="table" Content="{StaticResource TableIcon}" ToolTip="表格识别" AutomationProperties.Name="选区表格识别" />
                    <Border Width="1" Height="22" Margin="6,0" Background="{DynamicResource LineBrush}" />
                    <Button x:Name="InlineUndo" Style="{StaticResource VectorToolButton}" Click="Undo_Click" IsEnabled="False" Content="{StaticResource UndoIcon}" ToolTip="撤销（Ctrl+Z）" AutomationProperties.Name="撤销标注" />
                    <Button x:Name="InlineRedo" Style="{StaticResource VectorToolButton}" Click="Redo_Click" IsEnabled="False" Content="{StaticResource RedoIcon}" ToolTip="重做（Ctrl+Y）" AutomationProperties.Name="重做标注" />
                    <Button Style="{StaticResource VectorToolButton}" Click="Guides_Click" Content="{StaticResource TableIcon}" ToolTip="显示 / 隐藏辅助线" AutomationProperties.Name="切换辅助线" />
                    <Button Style="{StaticResource VectorToolButton}" Click="Reset_Click" Content="{StaticResource CaptureIcon}" ToolTip="重新选择区域（清除当前标注）" AutomationProperties.Name="重新选择区域" />
                    <Button Style="{StaticResource VectorToolButton}" Click="Output_Click" Tag="pin" Content="{StaticResource PinIcon}" ToolTip="贴到桌面" AutomationProperties.Name="选区贴图" />
                    <Button Style="{StaticResource VectorToolButton}" Click="Output_Click" Tag="save" Content="{StaticResource SaveIcon}" ToolTip="保存（Ctrl+S）" AutomationProperties.Name="保存选区" />
                    <Button Style="{StaticResource VectorToolButton}" Click="Output_Click" Tag="copy" Content="{StaticResource CopyIcon}" ToolTip="复制（Ctrl+C）" AutomationProperties.Name="复制选区" />
                    <Button Style="{StaticResource VectorToolButton}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource FocusBrush}" Click="Confirm_Click" Content="{StaticResource CheckIcon}" ToolTip="确定截图（Enter）" AutomationProperties.Name="确定截图" />
                    <Button Style="{StaticResource VectorToolButton}" Click="Cancel_Click" Content="{StaticResource CloseIcon}" ToolTip="取消（Esc）" AutomationProperties.Name="取消截图" />
                </WrapPanel>
            </Border>
        </Canvas>
        <Border x:Name="HintBar" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,7" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" IsHitTestVisible="False">
            <TextBlock Text="拖动选择区域   ·   Enter 确定   ·   Esc / 右键取消" />
        </Border>
    </Grid>
</Window>




