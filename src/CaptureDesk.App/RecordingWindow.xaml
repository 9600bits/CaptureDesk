<Window Style="{StaticResource AppWindowStyle}" x:Class="CaptureDesk.App.RecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIF 录制" Width="570" Height="215" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}" Topmost="True">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
            <TextBlock x:Name="ClockText" Text="00:00.0" FontSize="24" FontWeight="520"/>
            <StackPanel x:Name="Options" Orientation="Horizontal" HorizontalAlignment="Right">
                <Label Content="帧率" Foreground="{DynamicResource TextBrush}" Target="{Binding ElementName=FrameRate}" VerticalAlignment="Center"/>
                <ComboBox x:Name="FrameRate" Width="60" Foreground="Black" Background="White" SelectedIndex="1" VerticalAlignment="Center" AutomationProperties.Name="录制帧率">
                    <ComboBox.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="Black"/></Style></ComboBox.Resources>
                    <ComboBoxItem Tag="5"><TextBlock Text="5" Foreground="Black"/></ComboBoxItem>
                    <ComboBoxItem Tag="10"><TextBlock Text="10" Foreground="Black"/></ComboBoxItem>
                    <ComboBoxItem Tag="15"><TextBlock Text="15" Foreground="Black"/></ComboBoxItem>
                </ComboBox>
                <CheckBox x:Name="CursorToggle" Content="鼠标指针" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </DockPanel>
        <TextBlock Grid.Row="1" x:Name="StatusText" Text="选区已就绪 · GIF · 无音频" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
        <StackPanel Grid.Row="2" x:Name="TrimOptions" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,14">
            <Label Content="开始（秒）" Foreground="{DynamicResource TextBrush}" Target="{Binding ElementName=TrimStart}"/>
            <TextBox x:Name="TrimStart" Text="0" Width="74" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" VerticalContentAlignment="Center" AutomationProperties.Name="剪辑开始秒数"/>
            <Label Content="结束（秒）" Foreground="{DynamicResource TextBrush}" Target="{Binding ElementName=TrimEnd}" Margin="16,0,0,0"/>
            <TextBox x:Name="TrimEnd" Width="74" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" VerticalContentAlignment="Center" AutomationProperties.Name="剪辑结束秒数"/>
        </StackPanel>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ProgressBar x:Name="ExportProgress" Minimum="0" Maximum="100" Height="5" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="开始录制" Click="Start_Click"/>
                <Button x:Name="PauseButton" Style="{StaticResource SecondaryButton}" Content="暂停" IsEnabled="False" Click="Pause_Click" Margin="8,0,0,0"/>
                <Button x:Name="StopButton" Style="{StaticResource SecondaryButton}" Content="停止" IsEnabled="False" Click="Stop_Click" Margin="8,0,0,0"/>
                <Button x:Name="SaveButton" Style="{StaticResource SecondaryButton}" Content="保存 GIF" IsEnabled="False" Click="Save_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>



